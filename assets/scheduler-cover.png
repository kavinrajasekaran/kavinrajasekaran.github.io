<svg width="400" height="200" xmlns="http://www.w3.org/2000/svg">
  <!-- Background gradient -->
  <defs>
    <linearGradient id="scheduleGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0c4a6e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1e40af;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="scheduleGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#fbbf24;stop-opacity:0.2" />
      <stop offset="100%" style="stop-color:#fbbf24;stop-opacity:0" />
    </radialGradient>
  </defs>
  
  <rect width="400" height="200" fill="url(#scheduleGradient)"/>
  <rect width="400" height="200" fill="url(#scheduleGlow)"/>
  
  <!-- Calendar/Schedule grid -->
  <g transform="translate(60, 40)">
    <rect x="0" y="0" width="120" height="90" rx="5" fill="#f8fafc" stroke="#e2e8f0" stroke-width="2"/>
    
    <!-- Calendar header -->
    <rect x="0" y="0" width="120" height="20" rx="5" fill="#3b82f6"/>
    <text x="60" y="13" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="10" font-weight="bold">SCHEDULE</text>
    
    <!-- Calendar grid -->
    <line x1="0" y1="35" x2="120" y2="35" stroke="#e2e8f0" stroke-width="1"/>
    <line x1="0" y1="50" x2="120" y2="50" stroke="#e2e8f0" stroke-width="1"/>
    <line x1="0" y1="65" x2="120" y2="65" stroke="#e2e8f0" stroke-width="1"/>
    <line x1="30" y1="20" x2="30" y2="90" stroke="#e2e8f0" stroke-width="1"/>
    <line x1="60" y1="20" x2="60" y2="90" stroke="#e2e8f0" stroke-width="1"/>
    <line x1="90" y1="20" x2="90" y2="90" stroke="#e2e8f0" stroke-width="1"/>
    
    <!-- Sample course blocks -->
    <rect x="5" y="25" width="20" height="8" fill="#10b981" rx="2"/>
    <rect x="35" y="40" width="20" height="8" fill="#f59e0b" rx="2"/>
    <rect x="65" y="25" width="20" height="8" fill="#ef4444" rx="2"/>
    <rect x="95" y="55" width="20" height="8" fill="#8b5cf6" rx="2"/>
  </g>
  
  <!-- Data charts -->
  <g transform="translate(220, 50)">
    <!-- Bar chart -->
    <rect x="0" y="40" width="8" height="30" fill="#3b82f6"/>
    <rect x="12" y="30" width="8" height="40" fill="#10b981"/>
    <rect x="24" y="20" width="8" height="50" fill="#f59e0b"/>
    <rect x="36" y="35" width="8" height="35" fill="#ef4444"/>
    <rect x="48" y="25" width="8" height="45" fill="#8b5cf6"/>
    
    <!-- Chart base line -->
    <line x1="0" y1="70" x2="60" y2="70" stroke="#64748b" stroke-width="2"/>
    
    <!-- Line chart -->
    <g transform="translate(80, 0)">
      <polyline points="0,60 15,45 30,30 45,40 60,25" fill="none" stroke="#06b6d4" stroke-width="3"/>
      <circle cx="0" cy="60" r="3" fill="#06b6d4"/>
      <circle cx="15" cy="45" r="3" fill="#06b6d4"/>
      <circle cx="30" cy="30" r="3" fill="#06b6d4"/>
      <circle cx="45" cy="40" r="3" fill="#06b6d4"/>
      <circle cx="60" cy="25" r="3" fill="#06b6d4"/>
    </g>
  </g>
  
  <!-- UC Merced icon -->
  <g transform="translate(80, 120)">
    <circle cx="15" cy="15" r="12" fill="#fbbf24" stroke="#f59e0b" stroke-width="2"/>
    <text x="15" y="19" text-anchor="middle" fill="#0c4a6e" font-family="Arial, sans-serif" font-size="10" font-weight="bold">UC</text>
  </g>
  
  <!-- Stats indicators -->
  <g transform="translate(300, 120)">
    <rect x="0" y="0" width="30" height="15" rx="3" fill="#10b981" opacity="0.8"/>
    <text x="15" y="10" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="8">STATS</text>
  </g>
  
  <!-- Title -->
  <text x="200" y="160" text-anchor="middle" fill="#f1f5f9" font-family="Arial, sans-serif" font-size="16" font-weight="bold">UC Merced Course Stats</text>
  <text x="200" y="180" text-anchor="middle" fill="#94a3b8" font-family="Arial, sans-serif" font-size="12">Academic Planning & Analytics</text>
</svg>
