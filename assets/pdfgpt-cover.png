<svg width="400" height="200" xmlns="http://www.w3.org/2000/svg">
  <!-- Background gradient -->
  <defs>
    <linearGradient id="pdfGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f172a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1e293b;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="pdfGlow" cx="50%" cy="50%" r="60%">
      <stop offset="0%" style="stop-color:#e11d48;stop-opacity:0.2" />
      <stop offset="100%" style="stop-color:#e11d48;stop-opacity:0" />
    </radialGradient>
  </defs>
  
  <rect width="400" height="200" fill="url(#pdfGradient)"/>
  <rect width="400" height="200" fill="url(#pdfGlow)"/>
  
  <!-- PDF document icon -->
  <g transform="translate(70, 40)">
    <rect x="0" y="0" width="50" height="70" rx="3" fill="#f8fafc" stroke="#e2e8f0" stroke-width="2"/>
    <polygon points="50,0 50,15 35,15" fill="#e2e8f0"/>
    <line x1="8" y1="25" x2="42" y2="25" stroke="#64748b" stroke-width="2"/>
    <line x1="8" y1="35" x2="35" y2="35" stroke="#64748b" stroke-width="2"/>
    <line x1="8" y1="45" x2="40" y2="45" stroke="#64748b" stroke-width="2"/>
    <line x1="8" y1="55" x2="30" y2="55" stroke="#64748b" stroke-width="2"/>
    <text x="25" y="85" text-anchor="middle" fill="#e11d48" font-family="Arial, sans-serif" font-size="10" font-weight="bold">PDF</text>
  </g>
  
  <!-- Arrow pointing to AI -->
  <g transform="translate(140, 70)">
    <line x1="0" y1="0" x2="40" y2="0" stroke="#06b6d4" stroke-width="3" marker-end="url(#arrowhead)"/>
    <defs>
      <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="#06b6d4"/>
      </marker>
    </defs>
  </g>
  
  <!-- AI Brain/Chip -->
  <g transform="translate(200, 45)">
    <rect x="0" y="0" width="60" height="60" rx="8" fill="#1e293b" stroke="#06b6d4" stroke-width="2"/>
    <circle cx="30" cy="30" r="20" fill="none" stroke="#06b6d4" stroke-width="2"/>
    <circle cx="20" cy="20" r="3" fill="#06b6d4"/>
    <circle cx="40" cy="20" r="3" fill="#06b6d4"/>
    <circle cx="30" cy="40" r="3" fill="#06b6d4"/>
    <circle cx="15" cy="35" r="2" fill="#10b981"/>
    <circle cx="45" cy="35" r="2" fill="#10b981"/>
    <line x1="20" y1="20" x2="40" y2="20" stroke="#06b6d4" stroke-width="1"/>
    <line x1="20" y1="20" x2="30" y2="40" stroke="#06b6d4" stroke-width="1"/>
    <line x1="40" y1="20" x2="30" y2="40" stroke="#06b6d4" stroke-width="1"/>
  </g>
  
  <!-- Output arrow -->
  <g transform="translate(280, 70)">
    <line x1="0" y1="0" x2="30" y2="0" stroke="#10b981" stroke-width="3" marker-end="url(#arrowhead2)"/>
    <defs>
      <marker id="arrowhead2" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="#10b981"/>
      </marker>
    </defs>
  </g>
  
  <!-- Summary text bubbles -->
  <g transform="translate(320, 50)">
    <rect x="0" y="0" width="60" height="12" rx="6" fill="#10b981" opacity="0.8"/>
    <rect x="0" y="18" width="45" height="12" rx="6" fill="#10b981" opacity="0.6"/>
    <rect x="0" y="36" width="55" height="12" rx="6" fill="#10b981" opacity="0.4"/>
  </g>
  
  <!-- Title -->
  <text x="200" y="160" text-anchor="middle" fill="#f1f5f9" font-family="Arial, sans-serif" font-size="18" font-weight="bold">PDFgpt</text>
  <text x="200" y="180" text-anchor="middle" fill="#94a3b8" font-family="Arial, sans-serif" font-size="12">AI Document Summarization</text>
</svg>
