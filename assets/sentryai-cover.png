<svg width="400" height="200" xmlns="http://www.w3.org/2000/svg">
  <!-- Background gradient -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#16213e;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="centerGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:0.3" />
      <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:0" />
    </radialGradient>
  </defs>
  
  <rect width="400" height="200" fill="url(#bgGradient)"/>
  <rect width="400" height="200" fill="url(#centerGlow)"/>
  
  <!-- Security camera icon -->
  <g transform="translate(80, 60)">
    <rect x="0" y="20" width="40" height="25" rx="5" fill="#3b82f6" stroke="#60a5fa" stroke-width="2"/>
    <circle cx="20" cy="32" r="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2"/>
    <circle cx="20" cy="32" r="4" fill="#3b82f6"/>
    <line x1="40" y1="32" x2="55" y2="32" stroke="#60a5fa" stroke-width="3"/>
    <rect x="55" y="28" width="8" height="8" fill="#60a5fa"/>
  </g>
  
  <!-- AI Brain icon -->
  <g transform="translate(280, 50)">
    <path d="M 20 10 Q 35 5 40 20 Q 45 35 35 45 Q 20 50 5 45 Q 0 30 5 20 Q 10 5 20 10 Z" 
          fill="none" stroke="#10b981" stroke-width="2"/>
    <circle cx="15" cy="25" r="2" fill="#10b981"/>
    <circle cx="25" cy="20" r="2" fill="#10b981"/>
    <circle cx="30" cy="35" r="2" fill="#10b981"/>
    <line x1="15" y1="25" x2="25" y2="20" stroke="#10b981" stroke-width="1"/>
    <line x1="25" y1="20" x2="30" y2="35" stroke="#10b981" stroke-width="1"/>
    <line x1="30" y1="35" x2="15" y2="25" stroke="#10b981" stroke-width="1"/>
  </g>
  
  <!-- Detection zones -->
  <rect x="150" y="80" width="100" height="60" fill="none" stroke="#f59e0b" stroke-width="2" stroke-dasharray="5,5" opacity="0.7"/>
  <rect x="170" y="100" width="60" height="20" fill="#f59e0b" opacity="0.2"/>
  
  <!-- Title -->
  <text x="200" y="170" text-anchor="middle" fill="#e2e8f0" font-family="Arial, sans-serif" font-size="16" font-weight="bold">SentryAI</text>
  <text x="200" y="185" text-anchor="middle" fill="#94a3b8" font-family="Arial, sans-serif" font-size="12">WatchTower</text>
</svg> 